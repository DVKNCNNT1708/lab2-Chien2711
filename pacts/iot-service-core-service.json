{
  "consumer": {
    "name": "iot-service"
  },
  "interactions": [
    {
      "description": "a request to save sensor data",
      "request": {
        "body": {
          "deviceId": "sensor-01",
          "temp": 25
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/data"
      },
      "response": {
        "body": {
          "message": "Data received successfully"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.4.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "core-service"
  }
}